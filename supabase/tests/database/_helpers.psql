-- Ayudas para las pruebas pgTAP. Se incluyen con \ir desde cada archivo de prueba, dentro de su
-- transacción, así que todo lo que crean se descarta con el rollback final.
--
--   pg_temp.crear_empresa_y_locales()        → empresa "Prueba" con locales "Grill" y "Urban"
--   pg_temp.crear_usuario(id, email, nombre) → usuario de Auth + perfil
--   pg_temp.asignar_rol(user, local, rol)
--   pg_temp.crear_dispositivo(local, tipo)   → id del dispositivo (token = 'wkd_' || md5(id) x2)
--   pg_temp.como_mfa(user)                   → actúa como authenticated con sesión aal2
--   pg_temp.como_pin(user, dispositivo)      → actúa como authenticated con sesión PIN vigente
--   pg_temp.como_aal1(user)                  → authenticated aal1 sin sesión de dispositivo
--   pg_temp.como_postgres()                  → vuelve al rol de la sesión
--   pg_temp.filas_afectadas(sql)             → filas que modificó una sentencia con el rol actual

create function pg_temp.crear_empresa_y_locales()
returns void
language sql
as $$
  insert into public.empresas (id, ruc, razon_social)
  values ('e1000000-0000-4000-8000-000000000001', '20999999991', 'EMPRESA DE PRUEBA SAC');
  insert into public.locales (id, empresa_id, nombre, codigo_establecimiento_sunat) values
    ('e2000000-0000-4000-8000-00000000000a', 'e1000000-0000-4000-8000-000000000001', 'Grill Prueba', '0001'),
    ('e2000000-0000-4000-8000-00000000000b', 'e1000000-0000-4000-8000-000000000001', 'Urban Prueba', '0002');
  insert into public.pisos (id, local_id, nombre) values
    ('e3000000-0000-4000-8000-00000000000a', 'e2000000-0000-4000-8000-00000000000a', 'Piso A'),
    ('e3000000-0000-4000-8000-00000000000b', 'e2000000-0000-4000-8000-00000000000b', 'Piso B');
  insert into public.mesas (piso_id, local_id, codigo) values
    ('e3000000-0000-4000-8000-00000000000a', 'e2000000-0000-4000-8000-00000000000a', 'A1'),
    ('e3000000-0000-4000-8000-00000000000a', 'e2000000-0000-4000-8000-00000000000a', 'A2'),
    ('e3000000-0000-4000-8000-00000000000b', 'e2000000-0000-4000-8000-00000000000b', 'B1');
$$;

create function pg_temp.crear_usuario(p_id uuid, p_email text, p_nombre text default 'Usuario de prueba')
returns uuid
language sql
as $$
  insert into auth.users (instance_id, id, aud, role, email, encrypted_password, email_confirmed_at,
                          raw_app_meta_data, raw_user_meta_data, created_at, updated_at,
                          confirmation_token, recovery_token, email_change_token_new, email_change)
  values ('00000000-0000-0000-0000-000000000000', p_id, 'authenticated', 'authenticated', p_email, '', now(),
          '{"provider":"email","providers":["email"]}', '{}', now(), now(), '', '', '', '');
  insert into public.usuarios_perfil (user_id, nombre_visible) values (p_id, p_nombre);
  select p_id;
$$;

create function pg_temp.asignar_rol(p_user uuid, p_local uuid, p_rol text)
returns void
language sql
as $$
  insert into public.user_local_roles (user_id, local_id, role_id)
  select p_user, p_local, r.id from public.roles r where r.empresa_id is null and r.codigo = p_rol;
$$;

create function pg_temp.crear_dispositivo(p_local uuid, p_tipo text default 'tablet_mozo')
returns uuid
language plpgsql
as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into public.dispositivos (id, local_id, nombre, tipo, token_hash)
  values (v_id, p_local, 'Dispositivo ' || left(v_id::text, 8), p_tipo, app.hash_token(pg_temp.token_de(v_id)));
  return v_id;
end;
$$;

create function pg_temp.token_de(p_dispositivo uuid)
returns text
language sql
immutable
as $$
  select 'wkd_' || md5(p_dispositivo::text) || md5(p_dispositivo::text)
$$;

create function pg_temp.fijar_claims(p_claims jsonb)
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', p_claims::text, true);
  perform set_config('role', 'authenticated', true);
end;
$$;

create function pg_temp.como_mfa(p_user uuid)
returns void
language sql
as $$
  select pg_temp.fijar_claims(jsonb_build_object(
    'sub', p_user, 'role', 'authenticated', 'aal', 'aal2', 'session_id', gen_random_uuid()));
$$;

create function pg_temp.como_aal1(p_user uuid)
returns void
language sql
as $$
  select pg_temp.fijar_claims(jsonb_build_object(
    'sub', p_user, 'role', 'authenticated', 'aal', 'aal1', 'session_id', gen_random_uuid()));
$$;

create function pg_temp.como_pin(p_user uuid, p_dispositivo uuid, p_expira_en interval default interval '12 hours')
returns uuid
language plpgsql
as $$
declare
  v_session uuid := gen_random_uuid();
begin
  insert into app.sesiones_dispositivo (session_id, user_id, dispositivo_id, local_id, creada_at, expira_at)
  select v_session, p_user, d.id, d.local_id, now() - interval '13 hours', now() + p_expira_en
  from public.dispositivos d where d.id = p_dispositivo;
  perform pg_temp.fijar_claims(jsonb_build_object(
    'sub', p_user, 'role', 'authenticated', 'aal', 'aal1', 'session_id', v_session));
  return v_session;
end;
$$;

create function pg_temp.como_postgres()
returns void
language plpgsql
as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '', true);
end;
$$;

-- Ejecuta una sentencia con el rol actual y devuelve cuántas filas afectó (RLS filtra en silencio).
create function pg_temp.filas_afectadas(p_sql text)
returns integer
language plpgsql
as $$
declare
  v_filas integer;
begin
  execute p_sql;
  get diagnostics v_filas = row_count;
  return v_filas;
end;
$$;
