{
  "name": "@warike/print-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Agente local de impresión ESC/POS (fase 1); el relevo LAN llega en la fase 3",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "simulador": "tsx src/simulador-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "vitest": "^4.1.12"
  },
  "exports": {
