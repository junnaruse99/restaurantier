    "./conexion": "./src/conexion.ts",
    "./escpos": "./src/escpos/plantillas.ts",
    "./simulador": "./src/simulador.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "tsx": "^4.23.15"
  }
}
