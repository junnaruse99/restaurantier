# Variables del agente de impresión. En Windows se cargan con NSSM (AppEnvironmentExtra).
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<clave publicable del proyecto>
# Token que mostró el panel al registrar el dispositivo "agente de impresión" (solo se ve una vez).
WARIKE_DEVICE_TOKEN=wkd_<64 caracteres hexadecimales>
# Opcionales
# WARIKE_POLLING_MS=5000
# WARIKE_LATIDO_MS=30000
# WARIKE_PAGINA_CODIGOS=19
# WARIKE_USB_RUTA=/dev/usb/lp0
